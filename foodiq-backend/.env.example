# Database configuration (Supabase PostgreSQL / local PostgreSQL)
DATABASE_URL=jdbc:postgresql://HOST:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_database_password_here

# Server Port (Render sets this automatically; defaults to 8080 locally)
PORT=8080

# Security & Authentication
JWT_SECRET=your_secure_256bit_hex_secret_here

# Frontend Application URL (for OAuth2 redirects and CORS)
APP_FRONTEND_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# OCR / Tesseract Data Path (Optional override for custom deployments)
# TESSDATA_PREFIX=/usr/share/tesseract-ocr/4.00/tessdata
